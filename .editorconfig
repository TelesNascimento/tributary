root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,kts}]
indent_size = 2

[*.bat]
end_of_line = crlf

[src/test/resources/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false
end_of_line = unset
